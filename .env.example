VITE_API_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_AI_SERVICE=groq
# Nota: las API keys secretas (ej. NVIDIA_API_KEY) NO viven aqui.
# Deben configurarse solo en el backend/proxy y nunca con prefijo VITE_,
# porque Vite las incluiria en el bundle del cliente.
